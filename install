#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
target=${PH_INSTALL_ROOT:-$HOME}
codex_dir=${CODEX_HOME:-$target/.codex}
if [ -n "${PH_INSTALL_ROOT:-}" ]; then codex_dir=$target/.codex; fi

check_link() {
  if [ -e "$2" ] || [ -L "$2" ]; then
    if [ ! -L "$2" ] || [ "$(readlink "$2")" != "$1" ]; then
      printf 'Refusing to replace %s\n' "$2" >&2
      exit 1
    fi
  fi
}

link() {
  mkdir -p "$(dirname -- "$2")"
  if [ ! -L "$2" ]; then ln -s "$1" "$2"; fi
}

check_link "$repo" "$target/.config/purduehackers"
check_link "$repo/codex/purduehackers.config.toml" "$codex_dir/purduehackers.config.toml"
for skill in "$repo"/skills/*; do
  check_link "$skill" "$target/.agents/skills/$(basename -- "$skill")"
done

link "$repo" "$target/.config/purduehackers"
link "$repo/codex/purduehackers.config.toml" "$codex_dir/purduehackers.config.toml"
for skill in "$repo"/skills/*; do
  link "$skill" "$target/.agents/skills/$(basename -- "$skill")"
done
printf 'Installed Purdue Hackers profile and skills. Run ./sync-env, then codex --profile purduehackers.\n'
